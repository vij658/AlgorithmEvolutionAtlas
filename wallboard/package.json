{
  "name": "wallboard",
  "version": "1.0.0",
  "description": "Always-on dashboard for iPad, TV and phones. Node server + installable PWA.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/make-icons.mjs",
    "zip": "sh scripts/make-zip.sh"
  }
}
