{
  "name": "My widget",
  "description": "Copy this folder to start a new widget. Folders starting with _ are ignored.",
  "icon": "✨",
  "order": 50,
  "module": "widget.js",
  "styles": ["style.css"],
  "size": { "w": 3, "h": 2, "minW": 2, "minH": 1, "maxW": 12, "maxH": 8, "phoneH": 3 },
  "settings": [
    { "key": "message", "type": "text", "label": "Message", "default": "Hello, wall!" },
    { "key": "color", "type": "color", "label": "Accent colour", "default": "#5aa9ff" },
    { "key": "showTime", "type": "boolean", "label": "Show the time", "default": true }
  ]
}
